# Product name; keep it the same as NEXT_PUBLIC_APP_NAME in web and APP_NAME in api
APP_NAME=Scanaar
# The Express API. The admin app forwards /api/v1 to it (dev server in development, server.mjs in production)
API_URL=http://localhost:4000
# The public web app, for links to store pages
WEB_URL=http://localhost:3000
# Port for `npm run dev` and `npm start`
PORT=3001
